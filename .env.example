# Required environment variables for ReSage AI
# Copy this file to .env and fill in the values

# ── Gemini AI (required for AI-assisted analysis) ─────────────────────────────
# Get your free API key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: override the default model
# GEMINI_MODEL=gemini-2.5-flash

# ── Flask ─────────────────────────────────────────────────────────────────────
# Generate a strong random key: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=your_strong_secret_key_here

# Set to "true" only for local development
APP_DEBUG=false
